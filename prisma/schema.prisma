generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URI")
}

model User {
  id       String @id @default(uuid())
  login    String
  userName String

  email    String @unique
  password String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model Tariff {
  id String @id @default(uuid())

  name  String @unique
  price Int

  storageDays Int @map("storage_days")
  cameraLimit Int @map("camera_limit")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}
